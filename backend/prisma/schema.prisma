generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ─────────────────────────────────────────────

enum Plan {
  solo
  pro
  business
}

enum UserRole {
  super_admin
  account_owner
  staff
  accountant
}

enum Province {
  QC
  ON
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
}

enum JobStatus {
  pending
  in_progress
  completed
  cancelled
}

enum RecurringFrequency {
  daily
  weekly
  monthly
}

enum RecurringJobStatus {
  draft
  active
  paused
}

enum InvoiceStatus {
  draft
  sent
  paid
  failed
  overdue
  cancelled
}

enum PaymentLinkStatus {
  pending
  completed
  failed
}

enum ExpenseCategory {
  supplies
  equipment
  fuel
  wages
  insurance
  marketing
  storage
  training
  software
  other
}

// ─── MODELS ────────────────────────────────────────────

model Account {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  province  Province
  plan      Plan     @default(solo)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  subscription  Subscription?
  customers     Customer[]
  jobs          Job[]
  recurringJobs RecurringJob[]
  payrollEntries PayrollEntry[]
  invoices      Invoice[]
  expenses      Expense[]
  auditLogs     AuditLog[]

  @@map("accounts")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String?  @map("account_id") @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account        Account?       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  payrollEntries PayrollEntry[]
  assignedJobs   Job[]          @relation("JobAssignee")
  auditLogs      AuditLog[]
  adminActions   AdminAction[]

  @@index([accountId])
  @@map("users")
}

model Customer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  name       String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  address    String?  @db.VarChar(500)
  city       String?  @db.VarChar(100)
  province   String?  @db.VarChar(50)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  notes      String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jobs          Job[]
  recurringJobs RecurringJob[]
  invoices      Invoice[]

  @@unique([accountId, email])
  @@index([accountId])
  @@map("customers")
}

model Subscription {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String             @unique @map("account_id") @db.Uuid
  plan      Plan
  status    SubscriptionStatus @default(trialing)
  startDate DateTime           @map("start_date")
  endDate   DateTime?          @map("end_date")
  stripeCustomerId   String?   @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String? @map("stripe_subscription_id") @db.VarChar(255)
  trialEndsAt DateTime?        @map("trial_ends_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@map("refresh_tokens")
}

model Job {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  jobType       String    @default("Residential") @map("job_type") @db.VarChar(100)
  assignedTo    String?   @map("assigned_to") @db.Uuid
  status        JobStatus @default(pending)
  price         Decimal   @default(0) @db.Decimal(12, 2)
  duration      Decimal   @default(0) @db.Decimal(6, 2)
  supplies      Decimal   @default(0) @db.Decimal(12, 2)
  staffCount    Int       @default(1) @map("staff_count")
  notes         String?   @db.Text
  scheduledDate DateTime? @map("scheduled_date")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee User?     @relation("JobAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([accountId, status])
  @@index([accountId, scheduledDate])
  @@index([accountId, customerId])
  @@map("jobs")
}

model RecurringJob {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String             @map("account_id") @db.Uuid
  customerId   String?            @map("customer_id") @db.Uuid
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  jobType      String             @default("Recurring") @map("job_type") @db.VarChar(100)
  assignedTo   String?            @map("assigned_to") @db.Uuid
  frequency    RecurringFrequency
  nextRun      DateTime           @map("next_run")
  status       RecurringJobStatus @default(draft)
  failureCount Int                @default(0) @map("failure_count")
  price        Decimal            @default(0) @db.Decimal(12, 2)
  duration     Decimal            @default(0) @db.Decimal(6, 2)
  supplies     Decimal            @default(0) @db.Decimal(12, 2)
  staffCount   Int                @default(1) @map("staff_count")
  delivery     String             @default("Email") @db.VarChar(50)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  schedulerLogs SchedulerLog[]

  @@index([status, nextRun])
  @@map("recurring_jobs")
}

model PayrollEntry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  hours               Decimal  @db.Decimal(8, 2)
  hourlyRate          Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  flatPay             Decimal  @default(0) @map("flat_pay") @db.Decimal(12, 2)
  bonus               Decimal  @default(0) @db.Decimal(12, 2)
  taxableBenefits     Decimal  @default(0) @map("taxable_benefits") @db.Decimal(12, 2)
  vacationRate        Decimal  @default(0.04) @map("vacation_rate") @db.Decimal(5, 4)
  holidayPay          Decimal  @default(0) @map("holiday_pay") @db.Decimal(12, 2)
  grossPay            Decimal  @map("gross_pay") @db.Decimal(12, 2)
  deductionBreakdown  Json     @map("deduction_breakdown")
  totalDeductions     Decimal  @map("total_deductions") @db.Decimal(12, 2)
  netPay              Decimal  @map("net_pay") @db.Decimal(12, 2)
  province            Province
  workersCompAmount   Decimal  @default(0) @map("workers_comp_amount") @db.Decimal(12, 2)
  employerCosts       Decimal  @default(0) @map("employer_costs") @db.Decimal(12, 2)
  isInformationalOnly Boolean  @default(true) @map("is_informational_only")
  payType             String   @default("hourly") @map("pay_type") @db.VarChar(20)
  payPeriodStart      DateTime @map("pay_period_start") @db.Date
  payPeriodEnd        DateTime @map("pay_period_end") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([accountId, payPeriodStart])
  @@map("payroll_entries")
}

model Invoice {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String        @map("account_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  lineItems  Json          @map("line_items")
  subtotal   Decimal       @db.Decimal(12, 2)
  taxAmount  Decimal       @map("tax_amount") @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  status     InvoiceStatus @default(draft)
  invoiceNo  String        @map("invoice_no") @db.VarChar(50)
  issuedDate DateTime      @map("issued_date") @db.Date
  dueDate    DateTime      @map("due_date") @db.Date
  language   String        @default("en") @db.VarChar(5)
  notes      String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentLink PaymentLink?

  @@index([accountId, status])
  @@index([accountId, issuedDate])
  @@index([accountId, customerId])
  @@map("invoices")
}

model PaymentLink {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String            @unique @map("invoice_id") @db.Uuid
  stripeSessionId String?           @map("stripe_session_id") @db.VarChar(255)
  url             String?           @db.VarChar(2048)
  status          PaymentLinkStatus @default(pending)
  method          String            @default("Email") @db.VarChar(20)
  sentAt          DateTime?         @map("sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_links")
}

model Expense {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.Text
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@map("expenses")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  metadata  Json?
  timestamp DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, timestamp])
  @@map("audit_logs")
}

model AdminAction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  targetEntity String   @map("target_entity") @db.VarChar(100)
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json?
  timestamp    DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_actions")
}

model SchedulerLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurringJobId String   @map("recurring_job_id") @db.Uuid
  status         String   @db.VarChar(20)
  errorMessage   String?  @map("error_message") @db.Text
  executedAt     DateTime @default(now()) @map("executed_at")

  recurringJob RecurringJob @relation(fields: [recurringJobId], references: [id], onDelete: Cascade)

  @@index([recurringJobId, executedAt])
  @@map("scheduler_logs")
}

model TaxConfig {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  province Province
  taxYear  Int      @map("tax_year")
  rates    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([province, taxYear])
  @@map("tax_configs")
}
