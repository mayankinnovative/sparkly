# ─── Supabase PostgreSQL ───────────────────────────────
# Get these from your Supabase project: Settings > Database
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── JWT Secrets ───────────────────────────────────────
JWT_ACCESS_SECRET="your-access-secret-min-256-bit-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-256-bit-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email / SMTP ─────────────────────────────────────
# Leave blank to use Ethereal auto-test account (local dev only — emails go to ethereal.email)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="billing@sparkly.ca"
# SMTP_FROM_NAME="Sparkly Billing"

# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ─── Super Admin Seed ─────────────────────────────────
SUPER_ADMIN_EMAIL="admin@sparkly.ca"
SUPER_ADMIN_PASSWORD="Admin@123456"
